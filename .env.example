# Conversation, feedback, comparison and text content review: openai (default) or deepseek.
AI_PROVIDER=openai
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# OpenAI remains necessary for microphone/media transcription, standalone speech and frame OCR.
# Tavus Text Echo can speak model replies without an OpenAI key.
# Server-only. Copy values into local .env. Never paste secrets into chat.
# Required for real text AI, answer-specific feedback, STT and TTS:
OPENAI_API_KEY=
# Optional provider model/voice selection; no subscription is created by this app.
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_VOICE_AR=onyx
OPENAI_VOICE_EN=onyx

# Optional avatar layer. Text AI and voice work independently of this account.
# LiveAvatar LITE uses the OpenAI speech above; LiveAvatar voice/context IDs are NOT needed.
LIVEAVATAR_API_KEY=
LIVEAVATAR_AVATAR_ID=
# Confirm rights to the selected preset/custom avatar for your intended demo.
LIVEAVATAR_LICENSE_CONFIRMED=false
# Set true only for authorized use of the configured account's existing credits.
LIVEAVATAR_ENABLE_LIVE=false

# Select tavus only after running setup:tavus with a stock face selected.
AVATAR_PROVIDER=liveavatar
TAVUS_API_KEY=
# Stock Face ID (previously Replica ID) from the Tavus developer portal:
TAVUS_FACE_ID=
# Echo-mode PAL ID created by npm run setup:tavus (no default agent persona):
TAVUS_PAL_ID=

HOST=127.0.0.1
PORT=3000

# Avatar concurrency and available usage are enforced by Tavus.
# Basira caps Tavus sessions at 300 seconds, with a 150-second browser inactivity cutoff. Redis is not required.

# Separate full-pipeline PAL for real camera/microphone calls; keeps Echo PAL unchanged.
# Configure with: npx tsx scripts/setup/setup-tavus-video.ts
TAVUS_FULL_PAL_ID=

# Source retrieval for publication review (server-side; independent of avatar/model provider).
# Both approved hosted MCP services are used by default. false keeps only local Quran checks.
CONTENT_RETRIEVAL_ENABLED=true
# Optional bearer tokens only if the source service requires one. Never use model API keys here.
ISLAMIC_CONTENT_MCP_TOKEN=
TURATH_MCP_TOKEN=

# AI review audit: enabled by default. Logs prompts/transcripts and model responses server-side.
# Local default: SQLite; Vercel default: Redis (never ephemeral SQLite).
AI_AUDIT_ENABLED=true
# AI_AUDIT_STORE=sqlite
# AI_AUDIT_SQLITE_PATH=.local/ai-audit/ai-calls.sqlite
# For Redis, reuse existing credentials; no new service or paid plan is created.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Audio-based training coaching; uses OPENAI_API_KEY, independently of AI_PROVIDER.
# One additional audio-input request per recording when enabled in the UI.
OPENAI_AUDIO_ASSESSMENT_MODEL=gpt-audio-1.5

# Optional language-specific FULL PALs; fall back to TAVUS_FULL_PAL_ID.
# Configure an Arabic-suited voice on the Arabic PAL before assigning it.
TAVUS_FULL_PAL_ID_AR=
TAVUS_FULL_PAL_ID_EN=

# Source-guided training: same engine, separate routing and records per environment.
# Local development defaults to SQLite. NODE_ENV=production does not select production data.
BASIRA_ENV=development
BASIRA_DEV_INSTANCE=local
TRAINING_STORE=sqlite
# npm run dev:avatar fills these DEV values after opening an authenticated callback tunnel.
NGROK_AUTHTOKEN=
BASIRA_PUBLIC_URL_DEV=
TAVUS_TRAINING_PAL_ID_DEV=
# Production only. The deploy helper uploads these, never DEV values or the ngrok token.
BASIRA_PUBLIC_URL_PROD=
TAVUS_TRAINING_PAL_ID_PROD=
# Optional preview deployment: no automatic production fallback.
BASIRA_PUBLIC_URL_PREVIEW=
TAVUS_TRAINING_PAL_ID_PREVIEW=
BASIRA_PREVIEW_INSTANCE=preview

# Private content retrieval service; secrets remain server-only.
# Local: http://127.0.0.1:8010. Production: authenticated HTTPS service.
CONTENT_RAG_URL=
CONTENT_RAG_TOKEN=
# Python service only: persistent directory containing chroma.sqlite3 + index files.
CONTENT_RAG_DB_PATH=

# Explicit production retrieval settings; never deploy the local loopback URL.
CONTENT_RAG_URL_PROD=
CONTENT_RAG_TOKEN_PROD=

# Managed content retrieval (preferred over CONTENT_RAG_URL when configured).
# Server-only. Dense, 3072 dimensions, COSINE; existing embeddings are migrated unchanged.
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=
UPSTASH_VECTOR_NAMESPACE=basira-content-v1

# Shared per-browser request allowance; network allowance is 10x for shared Wi-Fi.
# Weighted units per minute; no avatar restart cooldown. Redis is required on Vercel.
AI_REQUEST_UNITS_PER_MINUTE=240
# Audit retention: oldest records expire/prune; no audio/video bytes are retained.
AI_AUDIT_RETENTION_DAYS=7
AI_AUDIT_MAX_RECORDS=1000
AI_AUDIT_MAX_BYTES=20971520

# Optional dedicated HMAC keys; when unset the server uses OPENAI_API_KEY with domain separation.
# Keep server-only; rotating CONTENT_PRACTICE_SECRET invalidates saved practice tickets.
CONTENT_PRACTICE_SECRET=
REQUEST_PROTECTION_SECRET=

# Optional private Vercel Blob store: direct uploads above the hosted 4 MiB body cap.
# Connect a PRIVATE store to the project. Never expose this token through VITE_*.
BLOB_READ_WRITE_TOKEN=
# Authenticates Vercel's hourly private-media retention cleanup. Server-only random secret.
CRON_SECRET=
